{
  "name": "nightdrive-leaderboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute nightdrive --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute nightdrive --remote --file=./schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.151.0"
  }
}
