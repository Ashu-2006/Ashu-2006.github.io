{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nightdrive-leaderboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "vars": {
    "ALLOWED_ORIGINS": "https://ashutoshdesigns.me,https://ashutosh-design-for.github.io",
    "MAX_SCORE": "200000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nightdrive",
      "database_id": "e576bed2-13d8-48cc-afeb-a5cb92724ede"
    }
  ]
}
